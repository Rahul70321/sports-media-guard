# Database Configuration
# Default is SQLite for local development
# DATABASE_URL="postgresql://user:password@cloud-db-host.com:5432/sports_media"
DATABASE_URL="sqlite:///./sports_media.db"

# Google Gemini API Key (for AI-powered legal summaries)
GEMINI_API_KEY=""

# Google Cloud Storage Configuration
# If these are empty or GCS client fails to initialize, files will be saved locally.
GCS_BUCKET_NAME="sports-media-assets-mvp"

# YouTube Data API (metadata and public thumbnails only; not full-video download)
YOUTUBE_API_KEY=""

# Explicit allowlists for server-side requests. Empty disables those features.
AUTHORIZED_FEED_ALLOWLIST=""
WEBHOOK_ALLOWLIST=""
ENABLE_MOCK_ADAPTER="true"

# Security and crawler limits
JWT_SECRET_KEY="replace-with-a-long-random-secret"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
CRAWLER_MAX_DOWNLOAD_BYTES="524288000"

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"
FRONTEND_URL="http://localhost:5173"
