# Database Configuration
# Default is SQLite for local development
# DATABASE_URL="postgresql://user:password@cloud-db-host.com:5432/sports_media"
DATABASE_URL="sqlite:///./sports_media.db"

# AWS Configuration for S3 (Cloud Storage)
# If these are empty, files will be saved locally.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="sports-media-assets-mvp"
